{
  "env": {
    "ECC_HOOK_PROFILE": "strict"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-commit.sh",
            "timeout": 600,
            "statusMessage": "커밋 명령 확인 중 (git commit이면 test, typecheck, lint, build 실행)"
          }
        ]
      }
    ]
  }
}
